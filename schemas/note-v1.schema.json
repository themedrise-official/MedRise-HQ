{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Reference schema. The authoritative rules are in js/validate.js (run: node tools/validate.mjs).",
  "title": "MedRise note-v1",
  "type": "object",
  "required": ["id", "template", "meta", "sections"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "template": { "const": "note-v1" },
    "status": { "enum": ["pending", "progress", "done"] },
    "schedule": { "type": ["object", "null"], "properties": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" } }, "required": ["date"] },
    "meta": { "type": "object", "required": ["title"], "properties": { "title": { "type": "string", "minLength": 1 }, "subtitle": { "type": "string" }, "class": { "type": "string" }, "chapter": { "type": "string" }, "crumb": { "type": "string" }, "syllabus_label": { "type": "string" }, "syllabus": { "type": "string" } } },
    "sections": { "type": "array", "items": { "type": "object", "required": ["heading", "blocks"], "properties": { "heading": { "type": "string", "minLength": 1 }, "blocks": { "type": "array", "items": { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["bullets", "table", "sub", "p", "note", "svg"] } } } } } } }
  }
}
